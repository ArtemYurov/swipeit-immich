# Your Immich server URL (required)
# Example: https://immich.yourdomain.com or http://192.168.1.50:2283
NEXT_PUBLIC_IMMICH_SERVER_URL=

# Optional: Auto-login credentials
# If provided, the app will attempt to log in automatically.
NEXT_PUBLIC_IMMICH_EMAIL=
NEXT_PUBLIC_IMMICH_PASSWORD=
NEXT_PUBLIC_IMMICH_ACCESS_TOKEN=

# Optional: Server-side environment variables for initial auth check (if used)
# These are only available on the server-side build/runtime
EMAIL=
PASSWORD=
